# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
/redwood/bin/hello_dyn started by launchd
/redwood/bin/svc_test
/redwood/bin/surf_test
/bin/ps -A
/redwood/bin/mg_test
/redwood/bin/cpu_test
/redwood/bin/cpu_test 240 &
# Wait for SpringBoard to boot and render homescreen
sleep 25
# Unlock homescreen via notification and swipe up
/redwood/bin/rwtouch notify com.hakios.unlock
/redwood/bin/rwtouch swipe 0.5 0.985 0.5 0.3 250
sleep 4
# Open Control Center (pull down from top right)
/redwood/bin/rwtouch swipe 0.88 0.02 0.88 0.45 300
sleep 4
# Dismiss Control Center (tap center screen)
/redwood/bin/rwtouch tap 0.5 0.85
sleep 3
# Swipe right to second page of homescreen
/redwood/bin/rwtouch swipe 0.85 0.50 0.15 0.50 300
sleep 4
# Swipe left to return to main page
/redwood/bin/rwtouch swipe 0.15 0.50 0.85 0.50 300
sleep 3
# Tap Settings icon (column 2, row 3)
/redwood/bin/rwtouch tap 0.615 0.71
sleep 6
# Swipe up from bottom home bar to exit app
/redwood/bin/rwtouch swipe 0.5 0.985 0.5 0.3 250
sleep 4
# Open Multitasking Switcher (drag up and pause)
/redwood/bin/rwtouch drag 0.5 0.995 0.5 0.60 400 1500
sleep 4
# Tap to return to homescreen
/redwood/bin/rwtouch tap 0.5 0.3
